{% comment %}
  Displays a customer-facing product-card price.

  Flip Lighter cards exclude the Tin Case Only variant so a case add-on does
  not appear to be the starting price of the lighter. Variant/PDP pricing is
  unchanged and continues to use Shopify's selected variant price.

  Accepts:
  - product: {Object} Product Liquid object
{% endcomment %}

{%- liquid
  assign display_price_min = product.price_min
  assign display_price_max = product.price_max
  assign product_type_handle = product.type | handleize

  if product_type_handle == 'flip-lighter'
    assign lighter_price_min = blank
    assign lighter_price_max = blank

    for product_variant in product.variants
      assign case_only_variant = false
      for variant_option in product_variant.options
        assign variant_option_handle = variant_option | handleize
        if variant_option_handle == 'tin-case-only'
          assign case_only_variant = true
          break
        endif
      endfor

      if product_variant.available and case_only_variant == false
        if lighter_price_min == blank or product_variant.price < lighter_price_min
          assign lighter_price_min = product_variant.price
        endif
        if lighter_price_max == blank or product_variant.price > lighter_price_max
          assign lighter_price_max = product_variant.price
        endif
      endif
    endfor

    if lighter_price_min != blank
      assign display_price_min = lighter_price_min
      assign display_price_max = lighter_price_max
    endif
  endif
-%}

{%- if product.available == false -%}
  Sold out
{%- elsif display_price_min != display_price_max -%}
  From {{ display_price_min | money_without_trailing_zeros }}
{%- else -%}
  {{ display_price_min | money_without_trailing_zeros }}
{%- endif -%}
