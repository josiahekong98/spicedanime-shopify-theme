{%- render 'cart-drawer' -%}

{% schema %}
{
  "name": "t:sections.cart-drawer.name",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.cart-drawer.settings.product_card_head.label"
    },
    {
      "type": "select",
      "id": "card_media_aspect_ratio",
      "label": "t:settings_schema.cards.settings.card_media_aspect_ratio.label",
      "options": [
        {
          "value": "1\/1",
          "label": "1:1"
        },
        {
          "value": "3\/4",
          "label": "3:4"
        },
        {
          "value": "5\/6",
          "label": "5:6"
        }
      ],
      "default": "3\/4"
    },
    {
      "type": "header",
      "content": "t:sections.cart-drawer.settings.empty_cart_head.label",
      "info": "Empty cart content can be updated from locales, under cart section."
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:sections.global.element.button.link.label",
      "default": "/collections"
    },
    {
      "type": "header",
      "content": "SpicedAnime cart upsells"
    },
    {
      "type": "text",
      "id": "upsell_heading",
      "label": "Add-on heading",
      "default": "Complete This Set"
    },
    {
      "type": "text",
      "id": "upsell_supporting_message",
      "label": "Add-on supporting message"
    },
    {
      "type": "header",
      "content": "Standard cart recommendations"
    },
    {
      "type": "collection",
      "id": "standard_lighter_collection",
      "label": "Standard recommendations: lighter collection"
    },
    {
      "type": "collection",
      "id": "standard_tapestry_collection",
      "label": "Standard recommendations: tapestry collection"
    },
    {
      "type": "collection",
      "id": "standard_pillow_collection",
      "label": "Standard recommendations: pillow collection"
    },
    {
      "type": "collection",
      "id": "standard_wallet_collection",
      "label": "Standard recommendations: wallet collection"
    },
    {
      "type": "collection",
      "id": "standard_tote_collection",
      "label": "Standard recommendations: tote collection"
    },
    {
      "type": "product_list",
      "id": "upsell_fallback_products",
      "label": "Fallback add-on products",
      "info": "Fills remaining standard recommendation slots after earlier sources. Complete This Set uses it only when earlier sources are empty.",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Promotion progress popup"
    },
    {
      "type": "checkbox",
      "id": "promotion_upsell_enabled",
      "label": "Enable promotion popup",
      "info": "Promotion pricing must be configured separately in Shopify Discounts or a Shopify Function.",
      "default": true
    },
    {
      "type": "range",
      "id": "promotion_max_recommendations",
      "label": "Maximum product options",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "promotion_prefer_same_series",
      "label": "Prefer products from the same series",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "promotion_random_fallback",
      "label": "Use eligible fallback products",
      "info": "When same-series options do not fill the popup, use other eligible products from the same promotion family.",
      "default": true
    },
    {
      "type": "collection",
      "id": "promotion_lighter_collection",
      "label": "Flip lighter promotion collection",
      "info": "Defaults to all-products-lighters. Exact Bundle values Tin Case Only, Lighter Only, and Lighter + Tin Case qualify for their matching offers."
    },
    {
      "type": "collection",
      "id": "promotion_stash_jar_collection",
      "label": "Stash jar promotion collection",
      "info": "Defaults to all-products-stash-jars."
    },
    {
      "type": "collection",
      "id": "promotion_grinder_collection",
      "label": "Grinder promotion collection",
      "info": "Defaults to herb-grinders. Exact Bundle values Grinder and Grinder+Jar+Tray qualify for their matching offers."
    },
    {
      "type": "collection",
      "id": "promotion_rolling_tray_collection",
      "label": "Rolling tray promotion collection",
      "info": "Defaults to all-rolling-trays."
    },
    {
      "type": "collection",
      "id": "promotion_ashtray_collection",
      "label": "Ashtray promotion collection",
      "info": "Defaults to all-products-ashtray. Only exact Bundle: Ashtray Only variants qualify."
    },
    {
      "type": "collection",
      "id": "promotion_tapestry_collection",
      "label": "Tapestry promotion collection",
      "info": "Defaults to all-tapestries. Only exact Tapestry and Black Art Tapestry product types qualify."
    },
    {
      "type": "collection",
      "id": "promotion_stash_box_collection",
      "label": "Stash box promotion collection",
      "info": "Defaults to all-products-stash-boxes. Only the exact full-set Bundle value qualifies."
    },
    {
      "type": "collection",
      "id": "promotion_tote_bag_collection",
      "label": "Tote bag promotion collection",
      "info": "Defaults to all-tote-bags. Includes only exact Tote Bags product types."
    },
    {
      "type": "collection",
      "id": "promotion_black_art_tote_collection",
      "label": "Black Art tote promotion collection",
      "info": "Optional dedicated source for exact Black Art Tapestry Tote Bag products. Defaults to the tote bag promotion collection."
    },
    {
      "type": "collection",
      "id": "promotion_sling_bag_collection",
      "label": "Sling bag promotion collection",
      "info": "Defaults to sling-bags. Includes only exact Sling Bag product types."
    },
    {
      "type": "checkbox",
      "id": "show_rewards_teaser",
      "label": "Show rewards teaser",
      "default": true
    },
    {
      "type": "text",
      "id": "rewards_eyebrow",
      "label": "Rewards label",
      "default": "REWARDS ARCHIVE"
    },
    {
      "type": "text",
      "id": "rewards_heading",
      "label": "Rewards heading",
      "default": "Spice Rewards"
    },
    {
      "type": "textarea",
      "id": "rewards_text",
      "label": "Rewards text",
      "default": "Earn Spice Points on eligible purchases and unlock future collector rewards."
    },
    {
      "type": "text",
      "id": "rewards_link_label",
      "label": "Rewards link label",
      "default": "View Rewards"
    },
    {
      "type": "url",
      "id": "rewards_link",
      "label": "Rewards link"
    }
  ],
  "blocks": [
    {
      "type": "info-bar",
      "name": "t:sections.cart-drawer.blocks.name",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "t:sections.global.element.icon.label",
          "info": "t:sections.global.element.icon.info",
          "default": "theme-box"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "t:sections.global.element.icon.custom_icon.label",
          "info": "t:sections.global.element.icon.custom_icon.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.global.element.title.label",
          "default": "Information title goes here"
        }
      ]
    }
  ]
}
{% endschema %}
