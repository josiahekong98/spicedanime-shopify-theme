{%- liquid
  assign selected_reviews = section.settings.reviews
  assign valid_review_count = 0

  for review in selected_reviews
    if review.review_text.value != blank
      assign valid_review_count = valid_review_count | plus: 1
    endif
  endfor

  assign is_product_page = false
  if request.page_type == 'product' and product != blank
    assign is_product_page = true
  endif

  assign display_limit = section.settings.homepage_display_limit
  if is_product_page
    assign display_limit = section.settings.product_display_limit
  endif
-%}

{%- if valid_review_count > 0 or request.design_mode -%}
  {{- 'sa-curated-reviews.css' | asset_url | stylesheet_tag -}}
{%- endif -%}

{%- if valid_review_count > 0 -%}
  <script src="{{ 'sa-curated-reviews.js' | asset_url }}" defer="defer"></script>

  {%- style -%}
    #shopify-section-{{ section.id }} .sa-curated-reviews {
      --sa-curated-padding-top: {{ section.settings.padding_top }}px;
      --sa-curated-padding-bottom: {{ section.settings.padding_bottom }}px;
      --sa-curated-image-ratio: {{ section.settings.image_ratio }};
    }
  {%- endstyle -%}

  <sa-curated-reviews
    id="SaCuratedReviews-{{ section.id }}"
    class="sa-curated-reviews sa-curated-reviews--{{ section.settings.section_width }}"
    data-section-id="{{ section.id }}"
    data-show-arrows="{{ section.settings.show_arrows }}"
    data-show-indicators="{{ section.settings.show_indicators }}"
    aria-labelledby="SaCuratedReviewsHeading-{{ section.id }}"
  >
    <div class="sa-curated-reviews__inner">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <header class="sa-curated-reviews__header">
          {%- if section.settings.eyebrow != blank -%}
            <p class="sa-curated-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="sa-curated-reviews__heading" id="SaCuratedReviewsHeading-{{ section.id }}">
              {{- section.settings.heading | escape -}}
            </h2>
          {%- else -%}
            <h2 class="visually-hidden" id="SaCuratedReviewsHeading-{{ section.id }}">Customer reviews</h2>
          {%- endif -%}
        </header>
      {%- else -%}
        <h2 class="visually-hidden" id="SaCuratedReviewsHeading-{{ section.id }}">Customer reviews</h2>
      {%- endif -%}

      <div class="sa-curated-reviews__stage">
        <div class="sa-curated-reviews__viewport" data-sa-review-viewport>
          <div class="sa-curated-reviews__track" data-sa-review-track role="list">
            {%- liquid
              assign rendered_count = 0
              assign rendered_review_keys = '|'
              assign matching_review_count = 0

              if is_product_page and product.type != blank
                for review in selected_reviews
                  if review.review_text.value != blank and review.product_type.value == product.type
                    assign matching_review_count = matching_review_count | plus: 1
                  endif
                endfor
              endif
            -%}

            {%- if is_product_page and product.type != blank and matching_review_count > 0 -%}
              {%- for review in selected_reviews -%}
                {%- liquid
                  if display_limit > 0 and rendered_count >= display_limit
                    break
                  endif

                  assign review_key = review.system.id | default: review.system.handle
                  assign review_marker = '|' | append: review_key | append: '|'
                -%}
                {%- if review.review_text.value != blank and review.product_type.value == product.type -%}
                  {%- unless rendered_review_keys contains review_marker -%}
                    {%- liquid
                      assign rendered_count = rendered_count | plus: 1
                      assign rendered_review_keys = rendered_review_keys | append: review_marker
                    -%}
                    {%- render 'sa-curated-review-card',
                      review: review,
                      render_index: rendered_count,
                      show_rating: section.settings.show_rating,
                      show_date: section.settings.show_date,
                      show_social_handle: section.settings.show_social_handle,
                      show_product_association: section.settings.show_product_association,
                      enable_product_links: section.settings.enable_product_links
                    -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}

              {%- for review in selected_reviews -%}
                {%- liquid
                  if display_limit > 0 and rendered_count >= display_limit
                    break
                  endif

                  assign review_key = review.system.id | default: review.system.handle
                  assign review_marker = '|' | append: review_key | append: '|'
                -%}
                {%- if review.review_text.value != blank and review.product_type.value != product.type -%}
                  {%- unless rendered_review_keys contains review_marker -%}
                    {%- liquid
                      assign rendered_count = rendered_count | plus: 1
                      assign rendered_review_keys = rendered_review_keys | append: review_marker
                    -%}
                    {%- render 'sa-curated-review-card',
                      review: review,
                      render_index: rendered_count,
                      show_rating: section.settings.show_rating,
                      show_date: section.settings.show_date,
                      show_social_handle: section.settings.show_social_handle,
                      show_product_association: section.settings.show_product_association,
                      enable_product_links: section.settings.enable_product_links
                    -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- for review in selected_reviews -%}
                {%- liquid
                  if display_limit > 0 and rendered_count >= display_limit
                    break
                  endif

                  assign review_key = review.system.id | default: review.system.handle
                  assign review_marker = '|' | append: review_key | append: '|'
                -%}
                {%- if review.review_text.value != blank -%}
                  {%- unless rendered_review_keys contains review_marker -%}
                    {%- liquid
                      assign rendered_count = rendered_count | plus: 1
                      assign rendered_review_keys = rendered_review_keys | append: review_marker
                    -%}
                    {%- render 'sa-curated-review-card',
                      review: review,
                      render_index: rendered_count,
                      show_rating: section.settings.show_rating,
                      show_date: section.settings.show_date,
                      show_social_handle: section.settings.show_social_handle,
                      show_product_association: section.settings.show_product_association,
                      enable_product_links: section.settings.enable_product_links
                    -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </div>

          {%- if rendered_count > 1 -%}
            {%- if section.settings.show_arrows or section.settings.show_indicators -%}
              <div class="sa-curated-reviews__navigation{% unless section.settings.show_arrows and section.settings.show_indicators %} sa-curated-reviews__navigation--single{% endunless %}" data-sa-review-navigation>
                {%- if section.settings.show_arrows -%}
                  <div class="sa-curated-reviews__arrows">
                    <button
                      class="sa-curated-reviews__arrow sa-curated-reviews__arrow--prev"
                      type="button"
                      data-sa-review-prev
                      aria-label="Previous review"
                    >
                      <span aria-hidden="true">←</span>
                    </button>
                    <button
                      class="sa-curated-reviews__arrow sa-curated-reviews__arrow--next"
                      type="button"
                      data-sa-review-next
                      aria-label="Next review"
                    >
                      <span aria-hidden="true">→</span>
                    </button>
                  </div>
                {%- endif -%}

                {%- if section.settings.show_indicators -%}
                  <div class="sa-curated-reviews__indicators" data-sa-review-indicators aria-label="Choose a review">
                    {%- for indicator_index in (1..rendered_count) -%}
                      <button
                        class="sa-curated-reviews__indicator{% if indicator_index == 1 %} is-active{% endif %}"
                        type="button"
                        data-sa-review-indicator="{{ forloop.index0 }}"
                        aria-label="Go to review {{ indicator_index }}"
                        {% if indicator_index == 1 %}aria-current="true"{% endif %}
                      >
                        <span aria-hidden="true"></span>
                      </button>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endif -%}

          <span class="sa-curated-reviews__blackout" data-sa-review-blackout aria-hidden="true"></span>
        </div>

        {%- if rendered_count > 1 -%}
          <p class="visually-hidden" data-sa-review-status aria-live="polite" aria-atomic="true">
            Review 1 of {{ rendered_count }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </sa-curated-reviews>
{%- elsif request.design_mode -%}
  <div class="sa-curated-reviews sa-curated-reviews--onboarding">
    <div class="sa-curated-reviews__inner">
      <div class="sa-curated-reviews__onboarding" role="status">
        <h2>{{ section.settings.heading | default: 'THEY JOINED US' | escape }}</h2>
        <p>Select published “Curated Customer Review” entries in this section’s Review entries setting. Each selected entry must include merchant-supplied review text and be available to the storefront.</p>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "SA Curated Reviews",
  "tag": "section",
  "class": "section-sa-curated-reviews",
  "settings": [
    {
      "type": "metaobject_list",
      "id": "reviews",
      "label": "Review entries",
      "metaobject_type": "curated_customer_review",
      "limit": 50
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CUSTOMER ARCHIVE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THEY JOINED US"
    },
    {
      "type": "range",
      "id": "homepage_display_limit",
      "label": "Homepage display limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "product_display_limit",
      "label": "Product-page display limit",
      "info": "Set to 0 to display all selected reviews.",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 0
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "3 / 4", "label": "Tall portrait (3:4)" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating when supplied",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show review date when supplied",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_handle",
      "label": "Show social handle when supplied",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_association",
      "label": "Show product association when supplied",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_product_links",
      "label": "Enable permitted product links",
      "info": "A link appears only when the review also permits linking and has an associated product.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show previous and next controls",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_indicators",
      "label": "Show active-slide indicators",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Page" },
        { "value": "wide", "label": "Wide" },
        { "value": "full", "label": "Full bleed" }
      ],
      "default": "wide"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "SA Curated Reviews"
    }
  ]
}
{% endschema %}
