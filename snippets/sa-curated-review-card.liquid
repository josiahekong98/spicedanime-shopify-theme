{%- liquid
  assign review_text = review.review_text.value
  assign review_photo = review.photo.value
  assign review_image = review_photo.preview_image | default: review_photo
  assign customer_name = review.customer_name.value
  assign rating_value = review.rating.value.rating | default: review.rating.value
  assign rating_max = review.rating.value.scale_max | default: 5
  assign review_date = review.review_date.value
  assign social_handle = review.social_handle.value
  assign associated_product = review.associated_product.value
  assign product_type = review.product_type.value
  assign image_alt = review.image_alt.value | default: review_image.alt | default: ''
  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'

  if render_index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign has_image = false
  if review_image != blank
    assign has_image = true
  endif

  assign rating_percentage = 0
  if rating_value != blank and rating_max > 0
    assign rating_percentage = rating_value | times: 100.0 | divided_by: rating_max
  endif

  assign should_link_product = false
  if enable_product_links and review.link_associated_product.value == true and associated_product != blank
    assign should_link_product = true
  endif

  assign has_attribution = false
  if customer_name != blank
    assign has_attribution = true
  elsif show_date and review_date != blank
    assign has_attribution = true
  elsif show_social_handle and social_handle != blank
    assign has_attribution = true
  endif
-%}

{%- if review_text != blank -%}
  <article
    class="sa-curated-review{% unless has_image %} sa-curated-review--text-only{% endunless %}"
    data-sa-review-slide
    role="listitem"
    aria-label="Review {{ render_index }}"
  >
    {%- if has_image -%}
      <div class="sa-curated-review__media">
        {{-
          review_image
          | image_url: width: 1800
          | image_tag:
            class: 'sa-curated-review__image',
            widths: '360, 540, 720, 900, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 58vw, 100vw',
            loading: image_loading,
            fetchpriority: image_fetchpriority,
            alt: image_alt
        -}}
      </div>
    {%- endif -%}

    <div class="sa-curated-review__content">
      {%- if show_product_association and product_type != blank -%}
        <p class="sa-curated-review__product-type">{{ product_type | escape }}</p>
      {%- endif -%}

      {%- if show_rating and rating_value != blank -%}
        <div
          class="sa-curated-review__rating"
          role="img"
          aria-label="{{ rating_value }} out of {{ rating_max }} stars"
          style="--sa-rating-fill: {{ rating_percentage }}%;"
        >
          <span class="sa-curated-review__stars" aria-hidden="true">★★★★★</span>
        </div>
      {%- endif -%}

      <blockquote class="sa-curated-review__quote">
        {{- review.review_text | metafield_tag -}}
      </blockquote>

      {%- if has_attribution -%}
        <footer class="sa-curated-review__attribution">
          {%- if customer_name != blank -%}
            <cite class="sa-curated-review__name">{{ customer_name | escape }}</cite>
          {%- endif -%}

          {%- if show_date and review_date != blank -%}
            <time class="sa-curated-review__date" datetime="{{ review_date | date: '%Y-%m-%d' }}">
              {{- review_date | date: '%b %d, %Y' -}}
            </time>
          {%- endif -%}

          {%- if show_social_handle and social_handle != blank -%}
            <span class="sa-curated-review__handle">{{ social_handle | escape }}</span>
          {%- endif -%}
        </footer>
      {%- endif -%}

      {%- if show_product_association and associated_product != blank -%}
        <div class="sa-curated-review__product">
          <span class="sa-curated-review__product-label">Featured exhibit</span>
          {%- if should_link_product -%}
            <a class="sa-curated-review__product-link" href="{{ associated_product.url }}">
              {{- associated_product.title | escape -}}
            </a>
          {%- else -%}
            <span class="sa-curated-review__product-title">{{ associated_product.title | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </article>
{%- endif -%}
